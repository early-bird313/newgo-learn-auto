# ========================================================
# ফেসবুক পেজ এবং এআই অটোমেশন কনফিগারেশন (.env)
# ========================================================

# ১. গুগল জেমিনি এআই এপিআই কি (https://aistudio.google.com/ থেকে সম্পূর্ণ ফ্রিতে নেওয়া যায়)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ২. ফেসবুক পেজ ক্রেডেনশিয়াল (Meta Graph API)
# আপনার পেজের আইডি (About সেকশনে পাবেন অথবা গ্রাফ এপিআই এক্সপ্লোরার থেকে)
FB_PAGE_ID=your_facebook_page_id_here

# আপনার পেজের Never-Expiring Page Access Token
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# ফেসবুক ওয়েবহুক ভেরিফিকেশন টোকেন (নিচে আপনার পছন্দমতো যেকোনো গোপন পাসওয়ার্ড/স্ট্রিং দিন)
FB_VERIFY_TOKEN=my_super_secret_verify_token_2026

# ৩. টাইমজোন এবং দৈনিক ড্রাফট শিডিউলার (সকাল ৯:০০ ও সন্ধ্যা ৬:০০ BST)
APP_TIMEZONE=Asia/Dhaka
SCHEDULE_MORNING_HOUR=9
SCHEDULE_MORNING_MINUTE=0
SCHEDULE_EVENING_HOUR=18
SCHEDULE_EVENING_MINUTE=0

# ৫. পোস্টের মূল বিষয়বস্তু বা নিশ
DEFAULT_POST_TOPIC=AI Tools & Technologies, Smart Tips & Useful Tricks, AI & Work Automation, Learning Resources, Productivity & Digital Skills, and New Ideas for the Future

# ৬. ছবির উৎস (Image Provider)
IMAGE_PROVIDER=pollinations
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ৭. সার্ভার পোর্ট
PORT=8000
